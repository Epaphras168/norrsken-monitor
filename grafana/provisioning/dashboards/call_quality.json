{
  "title": "Real-Time Call Quality \u2014 Norrsken Kigali",
  "uid": "norrsken-callquality-001",
  "tags": [
    "norrsken",
    "calls",
    "quality"
  ],
  "timezone": "Africa/Kigali",
  "refresh": "2m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Calls Right Now",
      "description": "Shows number of active media sessions per platform in the last 3 minutes. SOURCE: VictoriaMetrics metric 'real_time_media_quality_session_count', label 'platform'. Derived by stun_media_bridge.py querying Elasticsearch field 'network.application' (STUN + Google.Chat_Video.Call) with 'network.bytes' >= 500000. Session count = ES value_count aggregation on 'network.bytes' per platform per poll window.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO CALL",
                  "color": "gray"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 16,
          "valueSize": 24
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum by (platform) (real_time_media_quality_session_count{site=\"norrsken-kigali\"})",
          "legendFormat": "{{platform}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Microsoft Teams \u2014 Media Bitrate",
      "description": "Instantaneous Teams media bitrate per 2-minute window. SOURCE: VictoriaMetrics metrics 'real_time_media_quality_instant_total_bps', 'instant_upload_bps', 'instant_download_bps', label platform=Microsoft_Teams. Derived from Elasticsearch fields: 'fortinet.firewall.sentdelta' (upload bytes in last 120s), 'fortinet.firewall.rcvddelta' (download bytes in last 120s). Platform identified by 'destination.as.number' = 8075 (Microsoft Corporation). App classification: 'network.application' = STUN. Relay location: 'destination.geo.city_name', 'destination.geo.country_name'. Formula: bitrate_bps = (sentdelta + rcvddelta) * 8 / 120.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500000
              },
              {
                "color": "green",
                "value": 1500000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#1F78C1",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Upload"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#FF780A",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Download"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_total_bps{site=\"norrsken-kigali\",platform=\"Microsoft_Teams\"})",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_upload_bps{site=\"norrsken-kigali\",platform=\"Microsoft_Teams\"})",
          "legendFormat": "Upload",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_download_bps{site=\"norrsken-kigali\",platform=\"Microsoft_Teams\"})",
          "legendFormat": "Download",
          "refId": "C"
        }
