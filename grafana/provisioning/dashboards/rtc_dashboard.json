      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "fortigate_rtc_sla_packetloss{site=\"norrsken-kigali\"}",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ]
    },
