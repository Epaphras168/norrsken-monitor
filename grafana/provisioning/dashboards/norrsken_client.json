{
  "uid": "norrsken-client-001",
  "title": "Norrsken Kigali \u2014 Network Intelligence Report",
  "tags": [
    "norrsken",
    "client"
  ],
  "timezone": "Africa/Kigali",
  "refresh": "2m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "2m",
      "5m",
      "10m",
      "30m"
    ],
    "time_options": [
      "24h",
      "7d",
      "30d"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "WAN Link Status",
      "description": "Current status of all WAN interfaces connecting Norrsken to the internet.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "valueSize": 38
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "clamp_max(clamp_min(fortigate_interface_rx_rate_bps{site=\"norrsken-kigali\",interface=\"x3\"},0),1)",
          "legendFormat": "WAN (Fiber)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Video & Voice Calls Right Now",
      "description": "Number of active video and voice call sessions currently detected on the network.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {}
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_session_count{site=\"norrsken-kigali\",platform=\"Microsoft_Teams\"})",
          "legendFormat": "Microsoft Teams",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_session_count{site=\"norrsken-kigali\",platform=~\"Google_Meet.*\"})",
          "legendFormat": "Google Meet",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E886C3094E38"
          },
          "expr": "sum(real_time_media_quality_session_count{site=\"norrsken-kigali\",platform=\"Zoom\"})",
          "legendFormat": "Zoom",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_session_count{site=\"norrsken-kigali\",platform=\"WhatsApp_Voice\"})",
          "legendFormat": "WhatsApp Voice",
          "refId": "D"
        }
      ]
    },
    {
      "id": 3,
      "title": "Current Internet Speed",
      "description": "Live download and upload speed on the primary WAN interface.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 400000000
              },
              {
                "color": "red",
                "value": 600000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "fortigate_interface_rx_rate_bps{site=\"norrsken-kigali\",interface=\"x3\"}",
          "legendFormat": "Download",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "fortigate_interface_tx_rate_bps{site=\"norrsken-kigali\",interface=\"x3\"}",
          "legendFormat": "Upload",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Internet Speed Over Time",
      "description": "Download and upload speed throughout the day. Shows peak usage periods and any congestion.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Download"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Upload"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "fortigate_interface_rx_rate_bps{site=\"norrsken-kigali\",interface=\"x3\"}",
          "legendFormat": "Download",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "fortigate_interface_tx_rate_bps{site=\"norrsken-kigali\",interface=\"x3\"}",
          "legendFormat": "Upload",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Video & Voice Call Quality \u2014 Bitrate Over Time",
      "description": "Media bitrate for active calls. Higher and more consistent bitrate means better call quality. Drops indicate network congestion affecting calls.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_total_bps{site=\"norrsken-kigali\",platform=\"Microsoft_Teams\"})",
          "legendFormat": "Microsoft Teams",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_total_bps{site=\"norrsken-kigali\",platform=~\"Google_Meet.*\"})",
          "legendFormat": "Google Meet",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_total_bps{site=\"norrsken-kigali\",platform=\"Zoom\"})",
          "legendFormat": "Zoom",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sum(real_time_media_quality_instant_total_bps{site=\"norrsken-kigali\",platform=\"WhatsApp_Voice\"})",
          "legendFormat": "WhatsApp Voice",
          "refId": "D"
        }
      ]
    },
    {
      "id": 6,
      "title": "Network Latency \u2014 Response Time to Key Services",
      "description": "How quickly the network responds to key services. Lower is better. Above 150ms affects call quality noticeably.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "avg by (app) (fortigate_sdwan_sla_latency{site=\"norrsken-kigali\",app=~\"Microsoft_Teams|Google_Meet|Zoom|WhatsApp|Google_Chat_Video_Call\"})",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Packet Loss",
      "description": "Percentage of data packets lost in transit. Above 1% significantly impacts call quality. 0% is ideal.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "avg by (app) (fortigate_sdwan_sla_packetloss{site=\"norrsken-kigali\",app=~\"Microsoft_Teams|Google_Meet|Zoom|WhatsApp|Google_Chat_Video_Call\"})",
          "legendFormat": "{{app}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Top Applications by Bandwidth Usage",
      "description": "The top applications consuming bandwidth in the selected time period.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "displayMode": "basic",
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "Last *"
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "P4169E866C3094E38"
          },
          "expr": "sort_desc(topk(10, sum by (app) (fortigate_traffic_total_bytes{site=\"norrsken-kigali\"})))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "interval": "2m"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Fix Markers",
        "enable": true,
        "hide": false,
        "type": "tags",
        "builtIn": 0,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "tags": [
          "fix"
        ],
        "iconColor": "red"
      }
    ]
  }
}