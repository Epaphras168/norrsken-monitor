            "uid": "P4169E866C3094E38"
          },
          "expr": "fortigate_sdwan_sla_latency{site=\"norrsken-kigali\",app=\"Google_Chat_Video_Call\"}",
          "legendFormat": "Latency (ms)",
          "refId": "A"
        },
        {
